# =============================================================================
# Sentinel — AI Customer Support Agent
# Copy this file to .env.local and fill in your own keys.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# Get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key_here"

# --- AI providers (multi-key rotation) ---------------------------------------
# Comma-separated lists of API keys. The pipeline round-robins through them
# and marks any key returning 429 as cooling-down for 60s (or 1h for daily-
# quota errors), automatically falling over to the next key or the fallback
# provider. Free tiers are plenty for thousands of complaints when rotated.
#
# Get free Groq keys at:   https://console.groq.com/keys
# Get free Gemini keys at: https://aistudio.google.com/apikey

GROQ_API_KEYS="gsk_xxx,gsk_yyy,gsk_zzz"
GEMINI_API_KEYS="AIzaSy_xxx,AIzaSy_yyy"

# Single-key fallbacks (used if the *_KEYS variables above are unset)
# GROQ_API_KEY="gsk_xxx"
# GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy_xxx"
